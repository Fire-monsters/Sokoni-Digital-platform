FROM node:22.23.2-bookworm-slim AS build
RUN npm install --global pnpm@11.20.0
WORKDIR /repo
COPY . .
RUN pnpm --filter @sokoni-digital/api... install --frozen-lockfile
RUN pnpm --filter @sokoni-digital/api typecheck \
 && pnpm --filter @sokoni-digital/api build:production \
 && pnpm --filter @sokoni-digital/api deploy --legacy --prod /release

FROM node:22.23.2-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=4000
WORKDIR /app
COPY --from=build --chown=node:node /release/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/api/dist ./dist
USER node
EXPOSE 4000
CMD ["node", "dist/server.mjs"]
