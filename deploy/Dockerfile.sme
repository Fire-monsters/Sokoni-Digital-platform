FROM node:22.23.2-bookworm-slim AS build
RUN npm install --global pnpm@11.20.0
WORKDIR /repo
COPY . .
RUN pnpm --filter sme-dashboard... install --frozen-lockfile
ARG VITE_API_URL=https://api.solgemtradecomp.online
ARG VITE_WHOLESALE_ENABLED=true
ENV VITE_API_URL=$VITE_API_URL VITE_WHOLESALE_ENABLED=$VITE_WHOLESALE_ENABLED NITRO_PRESET=node-server
RUN pnpm --filter sme-dashboard build

FROM node:22.23.2-bookworm-slim AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/sme-dashboard/.output ./.output
USER node
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
