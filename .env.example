NODE_ENV=development
PORT=4000

SUPABASE_URL=https://uxkwybukiuhmtumqfnsz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_HcUrdWjyNnL-LG766pW19g_zioNFfJg
SUPABASE_SECRET_KEY=replace-with-your-secret-key
SUPABASE_JWKS_URL=https://uxkwybukiuhmtumqfnsz.supabase.co/auth/v1/.well-known/jwks.json

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=info
CHECKOUT_RESERVATION_MINUTES=15

# Payments remain fake locally. Use sandbox/production only with matching Pesapal credentials.
PAYMENTS_ENV=fake
PAYMENT_CALLBACK_BASE_URL=http://localhost:4000/v1/payments
PAYMENT_APP_RETURN_URL=consumermobile://payments/return
PAYMENT_PENDING_MAX_MINUTES=15
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_RECONCILIATION_BATCH_SIZE=100
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# Phase 5 notification delivery. Expo access tokens are optional for projects
# without push access security. Twilio is used only for critical SMS fallback.
NOTIFICATION_DELIVERY_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_POLL_INTERVAL_MS=15000
EXPO_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-from-supabase-status
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-from-supabase-status

# Supabase Auth server-side SMS provider (never prefix these with EXPO_PUBLIC_).
# For hosted Supabase, paste these into Authentication > Providers > Phone > Twilio.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token

# Supabase Google provider server-side settings.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-client-secret

VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-from-supabase-status
